# Phase one: fictional data only. No Shopify request is made in demo mode.
PORTAL_MODE=demo
APP_URL=http://127.0.0.1:3000
DATA_DIR=data

# Configure ALL of these on the server before changing PORTAL_MODE to live.
# APP_URL must match the browser origin and Shopify callback, with HTTPS in production.
ADMIN_EMAIL=support@dabbat.in
# Generate privately with: npm run password:hash
ADMIN_PASSWORD_HASH=
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Existing app Client ID and Client secret from Shopify Dev Dashboard.
# Never use NEXT_PUBLIC_ for any secret. Access tokens are obtained through OAuth.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Canonical permanent Shopify domain, NOT dabbat.in. Example format only:
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_orders,read_products
# Set true ONLY after confirming Shopify approval/access for protected customer data.
SHOPIFY_CUSTOMER_DATA_APPROVED=false

# Real seller details: address lines separated by |. Required for live invoices.
SELLER_NAME=Dabbat
SELLER_EMAIL=support@dabbat.in
SELLER_ADDRESS=
# Legacy SMTP fallback; keep configured until the Gmail API connection is tested.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Google OAuth Web Application credentials; server-side secrets only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Keep smtp until the internal Gmail API test succeeds; then optionally set gmail-api.
INVOICE_EMAIL_PROVIDER=smtp
# Shopify webhook auto-send is intentionally off until manually enabled after testing.
GMAIL_AUTO_SEND_ENABLED=false
# GST is disabled by default. Configure it in Settings only after registration.
